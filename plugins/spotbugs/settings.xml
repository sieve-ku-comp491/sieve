<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings of the build step. Every download goes to Maven Central through maven-proxy,
     whatever repositories the scanned project's pom.xml names (docs/interfaces.md, Build step). -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <localRepository>/cache/m2</localRepository>
  <interactiveMode>false</interactiveMode>
  <proxies>
    <proxy>
      <id>maven-proxy</id>
      <active>true</active>
      <protocol>https</protocol>
      <host>maven-proxy</host>
      <port>3128</port>
    </proxy>
  </proxies>
  <mirrors>
    <mirror>
      <id>maven-central</id>
      <name>Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
