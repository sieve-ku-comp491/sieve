      "taxonomies": [
        {
          "name": "CWE",
          "version": "4.10",
          "minimumRequiredLocalizedDataSemanticVersion": "4.10",
          "releaseDateUtc": "2023-01-31",
          "guid": "b8c54a32-de19-51d2-9a08-f0abfbaa7310",
          "informationUri": "https://cwe.mitre.org/data/published/cwe_v4.10.pdf/",
          "downloadUri": "https://cwe.mitre.org/data/xml/cwec_v4.10.xml.zip",
          "isComprehensive": true,
          "organization": "MITRE",
          "language": "en",
          "shortDescription": {
            "text": "The MITRE Common Weakness Enumeration"
          },
          "taxa": [
            {
              "id": "1004",
              "guid": "0783f9dc-1212-5d10-894d-057c797ba987",
              "shortDescription": {
                "text": "Sensitive Cookie Without 'HttpOnly' Flag"
              },
              "fullDescription": {
                "text": "The product uses a cookie to store sensitive information, but the cookie is not marked with the HttpOnly flag."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "117",
              "guid": "e4360770-eb15-55cf-8880-7051868a1961",
              "shortDescription": {
                "text": "Improper Output Neutralization for Logs"
              },
              "fullDescription": {
                "text": "The product does not neutralize or incorrectly neutralizes output that is written to logs."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "134",
              "guid": "c1004dd3-0fd4-59aa-9063-320f7523e5b4",
              "shortDescription": {
                "text": "Use of Externally-Controlled Format String"
              },
              "fullDescription": {
                "text": "The product uses a function that accepts a format string as an argument, but the format string originates from an external source."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "158",
              "guid": "6058bdc1-240c-5a84-806e-0988ab06ae5b",
              "shortDescription": {
                "text": "Improper Neutralization of Null Byte or NUL Character"
              },
              "fullDescription": {
                "text": "The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes NUL characters or null bytes when they are sent to a downstream component."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "176",
              "guid": "caae0840-1583-5ad6-9822-3d01b325b926",
              "shortDescription": {
                "text": "Improper Handling of Unicode Encoding"
              },
              "fullDescription": {
                "text": "The product does not properly handle when an input contains Unicode encoding."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "20",
              "guid": "b090a1e1-92d8-51fd-ac1f-fbc6939eb44d",
              "shortDescription": {
                "text": "Improper Input Validation"
              },
              "fullDescription": {
                "text": "The product receives input or data, but it does\n        not validate or incorrectly validates that the input has the\n        properties that are required to process the data safely and\n        correctly."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "203",
              "guid": "87991d23-2fc3-5120-b88b-2a9757717e43",
              "shortDescription": {
                "text": "Observable Discrepancy"
              },
              "fullDescription": {
                "text": "The product behaves differently or sends different responses under different circumstances in a way that is observable to an unauthorized actor, which exposes security-relevant information about the state of the product, such as whether a particular operation was successful or not."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "209",
              "guid": "f4809885-c9d6-5931-8bb1-50534e74f6cc",
              "shortDescription": {
                "text": "Generation of Error Message Containing Sensitive Information"
              },
              "fullDescription": {
                "text": "The product generates an error message that includes sensitive information about its environment, users, or associated data."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "22",
              "guid": "19cf96fc-1234-5a3d-8e5d-21b225b7d3e8",
              "shortDescription": {
                "text": "Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
              },
              "fullDescription": {
                "text": "The product uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the product does not properly neutralize special elements within the pathname that can cause the pathname to resolve to a location that is outside of the restricted directory."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "259",
              "guid": "50b06d54-751a-5af0-9a8c-5ba16677987d",
              "shortDescription": {
                "text": "Use of Hard-coded Password"
              },
              "fullDescription": {
                "text": "The product contains a hard-coded password, which it uses for its own inbound authentication or for outbound communication to external components."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "315",
              "guid": "1e8b2edd-a6e3-55f9-b6f2-739f59d0fd49",
              "shortDescription": {
                "text": "Cleartext Storage of Sensitive Information in a Cookie"
              },
              "fullDescription": {
                "text": "The product stores sensitive information in cleartext in a cookie."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "328",
              "guid": "dc1e99c1-c57b-5af0-85a4-9ad3bfac9c82",
              "shortDescription": {
                "text": "Use of Weak Hash"
              },
              "fullDescription": {
                "text": "The product uses an algorithm that produces a digest (output value) that does not meet security expectations for a hash function that allows an adversary to reasonably determine the original input (preimage attack), find another input that can produce the same hash (2nd preimage attack), or find multiple inputs that evaluate to the same hash (birthday attack)."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "330",
              "guid": "80cf7ee1-5a29-5fb4-a2f1-701272abf9b7",
              "shortDescription": {
                "text": "Use of Insufficiently Random Values"
              },
              "fullDescription": {
                "text": "The product uses insufficiently random numbers or values in a security context that depends on unpredictable numbers."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "352",
              "guid": "4cccead0-b8dc-5b81-98f4-9b2b99290363",
              "shortDescription": {
                "text": "Cross-Site Request Forgery (CSRF)"
              },
              "fullDescription": {
                "text": "The web application does not, or can not, sufficiently verify whether a well-formed, valid, consistent request was intentionally provided by the user who submitted the request."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "502",
              "guid": "ff25cc2c-fffa-57bc-8f05-4b360dd88816",
              "shortDescription": {
                "text": "Deserialization of Untrusted Data"
              },
              "fullDescription": {
                "text": "The product deserializes untrusted data without sufficiently verifying that the resulting data will be valid."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "552",
              "guid": "d6cffae3-f4ef-5209-b0e7-e53fdcbde3e5",
              "shortDescription": {
                "text": "Files or Directories Accessible to External Parties"
              },
              "fullDescription": {
                "text": "The product makes files or directories accessible to unauthorized actors, even though they should not be."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "611",
              "guid": "b7383f8c-a52b-52c9-b7d1-95a3c511d9da",
              "shortDescription": {
                "text": "Improper Restriction of XML External Entity Reference"
              },
              "fullDescription": {
                "text": "The product processes an XML document that can contain XML entities with URIs that resolve to documents outside of the intended sphere of control, causing the product to embed incorrect documents into its output."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "614",
              "guid": "06a50c3b-db90-53ee-9dcd-bdf22e7b9a5a",
              "shortDescription": {
                "text": "Sensitive Cookie in HTTPS Session Without 'Secure' Attribute"
              },
              "fullDescription": {
                "text": "The Secure attribute for sensitive cookies in HTTPS sessions is not set, which could cause the user agent to send those cookies in plaintext over an HTTP session."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "78",
              "guid": "de860c32-bc93-5e70-89d7-0877e5abaefb",
              "shortDescription": {
                "text": "Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"
              },
              "fullDescription": {
                "text": "The product constructs all or part of an OS command using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended OS command when it is sent to a downstream component."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "807",
              "guid": "2626368c-6d4f-5429-aa52-ee96a99c8655",
              "shortDescription": {
                "text": "Reliance on Untrusted Inputs in a Security Decision"
              },
              "fullDescription": {
                "text": "The product uses a protection mechanism that relies on the existence or values of an input, but the input can be modified by an untrusted actor in a way that bypasses the protection mechanism."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "89",
              "guid": "ef952f10-a202-504c-8649-9ffcb2291d69",
              "shortDescription": {
                "text": "Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"
              },
              "fullDescription": {
                "text": "The product constructs all or part of an SQL command using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended SQL command when it is sent to a downstream component."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "915",
              "guid": "ec76b642-6a30-570d-93b4-289a1b26ca78",
              "shortDescription": {
                "text": "Improperly Controlled Modification of Dynamically-Determined Object Attributes"
              },
              "fullDescription": {
                "text": "The product receives input from an upstream component that specifies multiple attributes, properties, or fields that are to be initialized or updated in an object, but it does not properly control which attributes can be modified."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "918",
              "guid": "5bb88194-5222-563c-b8e6-b0b769ed3c9a",
              "shortDescription": {
                "text": "Server-Side Request Forgery (SSRF)"
              },
              "fullDescription": {
                "text": "The web server receives a URL or similar request from an upstream component and retrieves the contents of this URL, but it does not sufficiently ensure that the request is being sent to the expected destination."
              },
              "defaultConfiguration": {
                "level": "none"
              }
            }
          ]
        }
      ]
    }
  ]
}
