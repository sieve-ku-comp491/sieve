       "physicalLocation": {
        "artifactLocation": {
         "uri": "/src/dockerized_labs/sql_injection_lab/app.py",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "endColumn": 82,
         "endLine": 69,
         "snippet": {
          "text": "        username = request.form.get(\"username\", \"\")\n        password = request.form.get(\"password\", \"\")\n\n        # Vulnerable SQL query construction (intentional)\n        sql_query = (\n            f\"SELECT * FROM users WHERE username='{username}' AND password='{password}'\"\n        )\n\n        try:\n            conn = sqlite3.connect(\"database.db\")\n            c = conn.cursor()\n            result = c.execute(sql_query).fetchone()\n            conn.close()\n\n            if result:\n                return render_template(\"lab.html\", logged_in_user=result[0])\n            else:\n                return render_template(\n                    \"lab.html\",\n                    error=\"Invalid username or password\",\n                    sql_query=sql_query,\n                )\n        except sqlite3.Error as e:\n            return render_template(\"lab.html\", error=str(e), sql_query=sql_query)"
         },
         "startColumn": 9,
         "startLine": 46
        }
       }
      }
     ],
     "message": {
      "text": "User-controlled data from a request is passed to 'execute()'. This could lead to a SQL injection and therefore protected information could be leaked. Instead, use django's QuerySets, which are built with query parameterization and therefore not vulnerable to sql injection. For example, you could use `Entry.objects.filter(date=2006)`."
     },
     "properties": {},
     "ruleId": "python.django.security.injection.sql.sql-injection-db-cursor-execute"
    },
